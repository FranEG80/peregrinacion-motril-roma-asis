---
import AccessForm from '../components/AccessForm.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
const error = Astro.url.searchParams.has('error') ? 'La contraseña no es correcta. Revísala e inténtalo de nuevo.' : Astro.url.searchParams.has('config') ? 'El acceso privado todavía no está configurado.' : '';
const returnTo = Astro.url.searchParams.get('returnTo') || '/album';
---
<Layout title="Acceso privado · Peregrinación a Roma" transitionReadyId="access-card">
  <Header active="home" />
  <main id="main-content" class="access-page">
    <section id="access-card">
      <p class="eyebrow">Contenido privado</p>
      <h1>Entrar en el álbum</h1>
      <p>Introduce la contraseña compartida con los peregrinos y sus familias.</p>
      <AccessForm returnTo={returnTo} error={error} />
      <a class="back" href="/">← Volver a la presentación</a>
    </section>
  </main>
</Layout>
<style>
  .access-page { display: grid; min-height: calc(100dvh - 4rem); place-items: center; padding: 1rem; }
  section { position: relative; width: min(100%, 26rem); border: 1px solid var(--line); border-radius: .35rem; padding: clamp(1.3rem, 5vw, 2rem); background: rgb(250 249 246 / .92); box-shadow: var(--shadow-soft); }
  section::after { position: absolute; right: -3rem; bottom: -2.5rem; width: 7rem; height: 7rem; background: url('/images/marginalia/scallop.png') center / contain no-repeat; content: ''; opacity: .17; pointer-events: none; }
  h1 { font-size: clamp(2rem, 7vw, 2.8rem); }
  section > p:not(.eyebrow) { color: var(--ink-700); }
  .back { display: inline-block; margin-top: 1.2rem; color: var(--muted); font-size: .82rem; font-weight: 800; }
</style>
