---
import Header from '../../components/organisms/Header.astro';
import Footer from '../../components/organisms/Footer.astro';
import AlbumHero from '../../components/organisms/AlbumHero.astro';
import Timeline from '../../components/organisms/Timeline.astro';
import SearchExperience from '../../components/search/SearchExperience';
import SectionHeading from '../../components/molecules/SectionHeading.astro';
import Marginalia from '../../components/atoms/Marginalia.astro';
import { pilgrimage } from '../../data/pilgrimage';
import { getGalleryCover } from '../../data/gallery';
import Layout from '../../layouts/Layout.astro';

const searchItems = pilgrimage.days.flatMap((day) => [
  { id: day.id, day: `Día ${day.number}`, title: day.title, summary: day.summary, href: `/album/dia/${day.slug}`, type: 'Día' as const },
  ...day.places.map((place) => ({ id: place.id, day: `Día ${day.number}`, title: place.name, summary: `${place.summary} ${place.description}`, href: `/album/dia/${day.slug}?lugar=${place.slug}`, type: 'Lugar' as const })),
]);

const covers = await Promise.all(pilgrimage.days.map((day) => getGalleryCover(day.slug).catch(() => undefined)));
const validCovers = covers.filter((cover): cover is string => Boolean(cover));
const timelineItems = pilgrimage.days.map((day, index) => ({
  id: day.id,
  sequence: day.number,
  eyebrow: `Día ${day.number}`,
  date: new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' }).format(new Date(`${day.date}T12:00:00`)),
  title: day.title,
  summary: day.summary,
  image: covers[index] || '',
  href: `/album/dia/${day.slug}`,
  meta: day.city,
}));
---

<Layout title={`Los cinco días · ${pilgrimage.title}`} description={pilgrimage.privateIntroduction} transitionReadyId="album-hero">
  <Header active="album" />
  <main id="main-content">
    <AlbumHero title="Roma y Asís, día a día" description={pilgrimage.privateIntroduction} covers={validCovers}>
      <SearchExperience client:idle items={searchItems} />
    </AlbumHero>

    <section class="relative overflow-clip py-section" aria-labelledby="journey-title">
      <Marginalia name="fountain" class="top-12 -right-8 w-36 opacity-10" />
      <Marginalia name="scallop" class="bottom-12 -left-8 w-36 -rotate-12 opacity-10" />
      <div class="container relative z-10">
        <SectionHeading
          eyebrow="La bitácora del viaje"
          title="Cinco capítulos en orden de camino"
          description="Cada jornada reúne sus lugares y conserva el archivo visual en el orden en que fue vivido."
          id="journey-title"
          align="split"
        />
        <div class="mt-10 border-t border-line pt-2">
          <Timeline items={timelineItems} variant="days" ariaLabel="Recorrido de los cinco días de la peregrinación" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
