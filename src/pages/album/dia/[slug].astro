---
import DayExperience from '../../../components/day-experience/DayExperience';
import Header from '../../../components/organisms/Header.astro';
import Footer from '../../../components/organisms/Footer.astro';
import DayHero from '../../../components/organisms/DayHero.astro';
import DaySwitcher from '../../../components/organisms/DaySwitcher.astro';
import SectionHeading from '../../../components/molecules/SectionHeading.astro';
import Marginalia from '../../../components/atoms/Marginalia.astro';
import { getDay, pilgrimage } from '../../../data/pilgrimage';
import { getGalleryDay } from '../../../data/gallery';
import Layout from '../../../layouts/Layout.astro';

const day = getDay(Astro.params.slug || '');
if (!day) return Astro.redirect('/album', 302);
let galleryDay;
let galleryError = '';
try {
  galleryDay = await getGalleryDay(day.slug);
} catch (error) {
  galleryError = error instanceof Error ? error.message : 'No se ha podido cargar la galería.';
}
const displayDay = galleryDay || day;
const date = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(`${day.date}T12:00:00`));
const marks = ['arch', 'vatican', 'colosseum', 'assisi-tower', 'olive-branch'];
---

<Layout title={`Día ${day.number}: ${displayDay.title} · ${pilgrimage.title}`} description={displayDay.summary} transitionReadyId="day-hero">
  <Header active="album" />
  <main id="main-content">
    <DayHero number={day.number} date={date} city={day.city} title={displayDay.title} summary={displayDay.summary} cover={displayDay.cover} dayId={day.id} />
    <DaySwitcher days={pilgrimage.days} activeId={day.id} />

    <section class="relative overflow-clip py-section" aria-labelledby="day-story-title">
      <Marginalia name={marks[day.number - 1]} class="top-10 -right-8 w-[clamp(7rem,14vw,11rem)] opacity-[0.08]" />
      <div class="container relative z-10">
        <SectionHeading
          eyebrow={`Día ${day.number} · archivo multimedia`}
          title="El camino, momento a momento"
          description="Las imágenes y vídeos conservan el orden del día. Abre cada pieza para leer su ficha completa o filtra por palabras clave."
          id="day-story-title"
          align="split"
        />
        {galleryDay ? <DayExperience client:load day={galleryDay} /> : <p class="mt-8 border-l-2 border-rust bg-rust/10 p-4 text-rust">{galleryError}</p>}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const cover = document.querySelector<HTMLElement>('[data-day-cover]');
    if (!cover) return;
    gsap.fromTo(cover, { scale: 1.06 }, {
      scale: 1,
      ease: 'none',
      scrollTrigger: { trigger: '#day-hero', start: 'top top', end: 'bottom top', scrub: .55 },
    });
  });
  document.addEventListener('astro:before-swap', () => mm.revert(), { once: true });
</script>
