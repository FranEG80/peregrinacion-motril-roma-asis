---
import DayExperience from '../../../components/DayExperience';
import Header from '../../../components/Header.astro';
import { getDay, pilgrimage } from '../../../data/pilgrimage';
import { getGalleryDay } from '../../../data/gallery';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/day-experience.css';

const day = getDay(Astro.params.slug || '');
if (!day) return Astro.redirect('/album', 302);
let galleryDay;
let galleryError = '';
try { galleryDay = await getGalleryDay(day.slug); } catch (error) { galleryError = error instanceof Error ? error.message : 'No se ha podido cargar la galería.'; }
const displayDay = galleryDay || day;
const date = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(`${day.date}T12:00:00`));
const marks = ['arch', 'vatican', 'colosseum', 'assisi-tower', 'olive-branch'];
---

<Layout title={`Día ${day.number}: ${displayDay.title} · ${pilgrimage.title}`} description={displayDay.summary} transitionReadyId="day-hero">
  <Header active="album" />
  <main id="main-content">
    <section id="day-hero" class="day-hero">
      <img src={displayDay.cover} width="1600" height="1067" alt="" fetchpriority="high" data-view-transition="page-cover" style={`--view-transition-name: day-cover-${day.id}`} />
      <div class="day-hero__shade" aria-hidden="true"></div>
      <div class="container day-hero__copy">
        <a href="/album">← Volver al itinerario</a>
        <p class="eyebrow">Día {day.number} · {date} · {day.city}</p>
        <h1 data-view-transition="page-title" style={`--view-transition-name: day-title-${day.id}`}>{displayDay.title}</h1>
        <p>{displayDay.summary}</p>
      </div>
    </section>

    <nav class="day-switcher" aria-label="Cambiar de jornada">
      <div class="container day-switcher__scroll">
        {pilgrimage.days.map((item) => (
          <a href={`/album/dia/${item.slug}`} aria-current={item.id === day.id ? 'step' : undefined}>
            <span>Día {item.number}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
      </div>
    </nav>

    <section class="day-story section" aria-labelledby="day-story-title">
      <img class="day-story__mark" src={`/images/marginalia/${marks[day.number - 1]}.png`} width="760" height="520" alt="" loading="lazy" />
      <div class="container">
        <div class="day-story__heading">
          <div>
            <p class="eyebrow">Día {day.number} · archivo multimedia</p>
            <h2 id="day-story-title" class="section-title">El camino, momento a momento</h2>
          </div>
          <p>Las imágenes y vídeos conservan el orden del día. Abre cada pieza para leer su ficha completa o filtra por palabras clave.</p>
        </div>
        {galleryDay ? <DayExperience client:load day={galleryDay} /> : <p class="gallery-error">{galleryError}</p>}
      </div>
    </section>
  </main>
</Layout>

<style>
  .day-hero { position: relative; display: grid; min-height: min(42dvh, 440px); align-items: end; overflow: hidden; background: var(--charcoal); color: white; }
  .day-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .day-hero__shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(36 35 31 / .88), rgb(36 35 31 / .2) 78%), linear-gradient(90deg, rgb(36 35 31 / .42), transparent); }
  .day-hero__copy { position: relative; padding-block: clamp(2rem, 5vw, 3.5rem); }
  .day-hero__copy > a { display: inline-flex; min-height: 2.5rem; align-items: center; margin-bottom: 1rem; color: #f4ede1; font-size: .72rem; font-weight: 800; text-underline-offset: .25rem; }
  .day-hero .eyebrow { margin-bottom: .5rem; color: #d9bc87; }
  .day-hero h1 { max-width: 16ch; font-size: clamp(2.1rem, 5vw, 3rem); }
  .day-hero h1 + p { max-width: 62ch; margin: .75rem 0 0; color: #eee5d8; font-size: .9rem; line-height: 1.6; }
  .day-switcher { border-bottom: 1px solid var(--line); background: var(--cream); }
  .day-switcher__scroll { display: grid; grid-template-columns: repeat(5, minmax(8.6rem, 1fr)); overflow-x: auto; padding-inline: 0; scrollbar-width: thin; }
  .day-switcher a { min-width: 0; border-left: 1px solid var(--line); padding: .7rem .8rem; color: var(--muted); text-decoration: none; transition: background-color 180ms ease, color 180ms ease; }
  .day-switcher a:last-child { border-right: 1px solid var(--line); }
  .day-switcher a:hover { background: var(--paper); color: var(--charcoal); }
  .day-switcher a[aria-current='step'] { background: var(--charcoal); color: var(--cream); }
  .day-switcher span { display: block; color: var(--gold); font-size: .56rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .day-switcher a[aria-current='step'] span { color: #d7b97e; }
  .day-switcher strong { display: block; overflow: hidden; font-family: var(--font-display); font-size: .78rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .day-story { position: relative; overflow: clip; }
  .day-story__mark { position: absolute; top: 2rem; right: -1.5rem; width: clamp(7rem, 14vw, 11rem); max-height: 11rem; object-fit: contain; opacity: .09; pointer-events: none; }
  .day-story__heading { position: relative; z-index: 1; display: grid; gap: 1rem; border-bottom: 1px solid var(--line); padding-bottom: 1.8rem; }
  .day-story__heading > p { max-width: 54ch; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.65; }
  .gallery-error { margin-top: 2rem; border-left: 2px solid var(--rust); padding: .8rem 1rem; background: #f1e4df; color: var(--rust); }

  @media (min-width: 760px) {
    .day-story__heading { grid-template-columns: .9fr 1.1fr; align-items: end; }
    .day-story__heading > p { justify-self: end; }
  }
</style>
