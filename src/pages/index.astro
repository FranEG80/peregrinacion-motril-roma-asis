---
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import HomeHero from '../components/organisms/HomeHero.astro';
import DayChapterCard from '../components/organisms/DayChapterCard.astro';
import AccessDialog from '../components/organisms/AccessDialog.astro';
import Layout from '../layouts/Layout.astro';
import { pilgrimage } from '../data/pilgrimage';
import { getHomeDayPreviews } from '../data/gallery';
import { getAuthConfig } from '../domain/auth';

const days = getHomeDayPreviews();
const isPrivate = getAuthConfig().mode === 'private';
const marginalia = ['vatican', 'arch', 'colosseum', 'assisi-tower', 'olive-branch'];
const dateFormatter = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' });

---

<Layout title={`${pilgrimage.title} · Álbum del camino`} description={pilgrimage.publicIntroduction[0]} transitionReadyId="home-hero">
  <Header active="home" />
  <main id="main-content">
    <HomeHero
      title={pilgrimage.title}
      subtitle={pilgrimage.subtitle}
      dates={pilgrimage.dates}
      image={pilgrimage.hero}
      isPrivate={isPrivate}
    />

    <section aria-labelledby="journey-title">
      <div class="relative overflow-hidden border-b border-line bg-cream">
        <img
          class="pointer-events-none absolute -left-9 bottom-0 hidden w-24 opacity-[0.055] mix-blend-multiply lg:block"
          src="/images/marginalia/column.png"
          width="178"
          height="760"
          alt=""
          loading="lazy"
        />

        <div class="container grid items-center gap-12 py-[clamp(4.5rem,8vw,7.5rem)] lg:grid-cols-[minmax(0,0.76fr)_minmax(0,1.24fr)] lg:gap-[clamp(4rem,7vw,7rem)]">
          <div class="max-w-[30rem]">
            <div class="mb-5 flex items-center gap-3 text-[0.66rem] font-medium tracking-[0.18em] text-gold uppercase">
              <span class="h-px w-8 bg-gold-bright" aria-hidden="true"></span>
              <p>El viaje · día a día</p>
            </div>

            <h2 id="journey-title" class="max-w-[18ch] font-serif text-[clamp(2rem,3.1vw,3.05rem)] leading-[1.08] font-medium tracking-[-0.032em] text-charcoal">
              Cinco jornadas entre Roma y Asís.
            </h2>

            <div class="mt-7 max-w-[29rem] space-y-4 text-[0.94rem] leading-[1.75] text-muted">
              {pilgrimage.publicIntroduction.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4 text-[0.64rem] font-medium tracking-[0.14em] text-gold uppercase">
              <p>7—11 julio 2026</p>
              <span class="size-1 rounded-full bg-gold-bright" aria-hidden="true"></span>
              <p>Roma → Asís</p>
            </div>
          </div>

          <figure class="m-0 min-w-0">
            <div class="relative">
              <div class="absolute -inset-2 border border-gold/15 bg-paper/60 sm:-inset-3" aria-hidden="true"></div>
              <div class="relative overflow-hidden border border-[#cdbfa8] bg-[#eee4d2] p-1.5 shadow-plate sm:p-2.5">
                <img
                  class="block h-auto w-full"
                  src="/images/editorial/rome-assisi-pencil.webp"
                  width="2048"
                  height="1153"
                  alt="Ilustración a lápiz que enlaza la columnata de Roma con el perfil medieval de Asís"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <figcaption class="mt-5 flex items-center justify-between gap-4 text-[0.6rem] font-medium tracking-[0.13em] text-muted uppercase">
              <span>Roma → Asís</span>
              <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
              <span>Memoria dibujada</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <div>
        {days.map((day, index) => (
          <DayChapterCard
            day={day}
            index={index}
            formattedDate={dateFormatter.format(new Date(`${day.date}T12:00:00`))}
            isPrivate={isPrivate}
            marginalia={marginalia[index]}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer variant="story" />
  {isPrivate && <AccessDialog />}
</Layout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const dialog = document.querySelector<HTMLDialogElement>('#access-dialog');
  let opener: HTMLElement | null = null;
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-open-access]');
  const openDialog = (event: Event) => {
    opener = event.currentTarget as HTMLElement;
    if (dialog && !dialog.open) dialog.showModal();
  };
  const restoreFocus = () => opener?.focus();
  openers.forEach((button) => button.addEventListener('click', openDialog));
  dialog?.addEventListener('close', restoreFocus);
  if (new URLSearchParams(window.location.search).has('access')) dialog?.showModal();

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const intro = gsap.timeline({ defaults: { duration: .68, ease: 'power3.out' } });
    intro
      .from('[data-hero-reveal]', { autoAlpha: 0, y: 22, stagger: .08, clearProps: 'opacity,visibility,transform' })
      .from('[data-hero-cover]', { scale: 1.045, duration: 1.1 }, 0);

    gsap.utils.toArray<HTMLElement>('[data-chapter]').forEach((chapter) => {
      const targets = chapter.querySelectorAll('[data-chapter-copy], [data-chapter-photos]');
      gsap.from(targets, {
        autoAlpha: 0,
        y: 24,
        duration: .72,
        stagger: .08,
        ease: 'power3.out',
        clearProps: 'opacity,visibility,transform',
        scrollTrigger: { trigger: chapter, start: 'clamp(top 82%)', once: true },
      });
    });
  });

  document.addEventListener('astro:before-swap', () => {
    mm.revert();
    openers.forEach((button) => button.removeEventListener('click', openDialog));
    dialog?.removeEventListener('close', restoreFocus);
  }, { once: true });
</script>
