---
import { Eye, EyeOff } from 'lucide-preact';
interface Props { enhanced?: boolean; returnTo?: string; error?: string; }
const { enhanced = false, returnTo = '/album', error = '' } = Astro.props;
---

<form class="access-form" method="post" action="/api/access" data-access-form={enhanced ? '' : undefined}>
  <input type="hidden" name="returnTo" value={returnTo} />
  <label for={enhanced ? 'dialog-password' : 'page-password'}>Contraseña compartida</label>
  <div class="password-field">
    <input id={enhanced ? 'dialog-password' : 'page-password'} name="password" type="password" autocomplete="current-password" required aria-describedby={enhanced ? 'dialog-access-error' : 'page-access-error'} />
    <button type="button" data-toggle-password aria-label="Mostrar contraseña" aria-pressed="false">
      <Eye size={18} strokeWidth={1.7} data-eye />
      <EyeOff size={18} strokeWidth={1.7} data-eye-off hidden />
    </button>
  </div>
  <p id={enhanced ? 'dialog-access-error' : 'page-access-error'} class="form-message" role="alert" aria-live="polite">{error}</p>
  <button class="button" type="submit">Entrar al álbum</button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.access-form').forEach((form) => {
    const password = form.querySelector<HTMLInputElement>('input[type="password"], input[type="text"]');
    const toggle = form.querySelector<HTMLButtonElement>('[data-toggle-password]');
    toggle?.addEventListener('click', () => {
      if (!password) return;
      const visible = password.type === 'text';
      password.type = visible ? 'password' : 'text';
      toggle.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
      toggle.setAttribute('aria-pressed', String(!visible));
      toggle.querySelector<SVGElement>('[data-eye]')?.toggleAttribute('hidden', !visible);
      toggle.querySelector<SVGElement>('[data-eye-off]')?.toggleAttribute('hidden', visible);
    });
    if (!form.hasAttribute('data-access-form')) return;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const message = form.querySelector<HTMLElement>('[role="alert"]');
      if (submit) { submit.disabled = true; submit.textContent = 'Comprobando…'; }
      if (message) message.textContent = '';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'No se ha podido acceder.');
        window.location.assign(result.redirectTo || '/album');
      } catch (error) {
        if (message) message.textContent = error instanceof Error ? error.message : 'No se ha podido acceder.';
        password?.focus();
      } finally {
        if (submit) { submit.disabled = false; submit.textContent = 'Entrar al álbum'; }
      }
    });
  });
</script>

<style>
  .access-form { display: grid; gap: .55rem; margin-top: 1.2rem; }
  label { font-size: .82rem; font-weight: 800; }
  .password-field { display: grid; grid-template-columns: minmax(0, 1fr) 2.9rem; overflow: clip; border: 1px solid var(--line); border-radius: .2rem; background: white; }
  .password-field:focus-within { border-color: var(--gold); box-shadow: 0 0 0 3px rgb(155 122 67 / .13); }
  input { min-width: 0; min-height: 2.85rem; border: 0; padding-inline: .9rem; outline: 0; }
  .password-field button { display: grid; place-items: center; border: 0; border-inline-start: 1px solid var(--line); background: var(--paper); color: var(--charcoal); cursor: pointer; }
  .password-field button:hover { background: #eee4d5; }
  .password-field [hidden] { display: none; }
  .form-message { min-height: 1.5em; margin: 0; color: var(--rust); font-size: .8rem; font-weight: 750; }
</style>
