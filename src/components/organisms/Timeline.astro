---
import PhotoPlate from '../molecules/PhotoPlate.astro';
interface TimelineItem {
  id: string;
  sequence: number;
  eyebrow: string;
  title: string;
  summary: string;
  date?: string;
  approximateTime?: string;
  image?: string;
  href: string;
  meta?: string;
}
interface Props {
  items: TimelineItem[];
  variant: 'days' | 'places';
  activeId?: string;
  ariaLabel: string;
}
const { items, variant, activeId, ariaLabel } = Astro.props;
---

<div class="relative mt-10" data-timeline data-variant={variant}>
  <div class="absolute top-0 bottom-0 left-[1.15rem] w-px bg-line md:left-[1.45rem]" aria-hidden="true">
    <span class="timeline-progress block h-full w-full origin-top scale-y-0 bg-gold"></span>
  </div>
  <ol class="m-0 grid list-none p-0" aria-label={ariaLabel}>
    {items.map((item, index) => (
      <li
        class:list={[
          'group/timeline relative pb-14 pl-14 md:pb-20 md:pl-21 [&.is-current_.timeline-marker]:border-gold [&.is-current_.timeline-marker]:bg-gold [&.is-current_.timeline-marker]:text-cream',
          item.id === activeId && 'is-current',
        ]}
        data-timeline-item
      >
        <span class="timeline-marker absolute top-0 left-0 z-10 grid size-[2.3rem] place-items-center rounded-full border border-line bg-paper font-serif text-xs text-muted shadow-[0_0_0_6px_var(--color-paper)] transition-colors md:size-[2.9rem] md:text-sm" aria-hidden="true">
          {String(item.sequence).padStart(2, '0')}
        </span>
        <a
          href={item.href}
          aria-current={item.id === activeId ? 'step' : undefined}
          class:list={[
            'group grid gap-6 border-t border-line pt-5 text-charcoal no-underline md:grid-cols-[minmax(15rem,0.8fr)_minmax(0,1.2fr)] md:gap-[clamp(2rem,5vw,4.5rem)]',
            index % 2 === 1 && 'md:grid-cols-[minmax(0,1.2fr)_minmax(15rem,0.8fr)]',
          ]}
        >
          {item.image ? (
            <PhotoPlate
              class={`min-h-56 overflow-hidden ${index % 2 === 1 ? 'md:order-2' : ''}`}
              src={item.image}
              width={960}
              height={720}
              alt=""
              caption={`Capítulo ${String(item.sequence).padStart(2, '0')}`}
              transitionName={variant === 'days' ? `day-cover-${item.id}` : undefined}
            />
          ) : (
            <div class="grid min-h-48 place-items-center rounded-plate border border-dashed border-line text-xs tracking-[0.1em] text-muted uppercase">Recuerdo sin fotografía</div>
          )}
          <div class:list={['max-w-[38rem] self-center', index % 2 === 1 && 'md:order-1']}>
            <p class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-[0.65rem] font-extrabold tracking-[0.14em] text-gold uppercase">
              <span>{item.date || item.approximateTime || item.eyebrow}</span>
              {item.meta && <span class="text-muted">{item.meta}</span>}
            </p>
            <h3
              class="max-w-[19ch] font-serif text-title-sm leading-[1.05] font-medium tracking-[-0.03em]"
              data-view-transition={variant === 'days' ? 'page-title' : undefined}
              style={variant === 'days' ? `--view-transition-name: day-title-${item.id}` : undefined}
            >
              {item.title}
            </h3>
            <p class="mt-4 text-sm leading-7 text-muted">{item.summary}</p>
            <span class="mt-5 inline-flex gap-2 border-b border-gold text-xs font-extrabold">
              {variant === 'days' ? `Abrir jornada ${item.sequence}` : 'Abrir parada'}
              <span class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</div>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const cleanups: Array<() => void> = [];
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((timeline) => {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const progress = timeline.querySelector<HTMLElement>('.timeline-progress');
      if (progress) {
        gsap.to(progress, {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: { trigger: timeline, start: 'clamp(top 68%)', end: 'clamp(bottom 68%)', scrub: .35 },
        });
      }
      gsap.utils.toArray<HTMLElement>('[data-timeline-item]', timeline).forEach((item) => {
        ScrollTrigger.create({ trigger: item, start: 'top 62%', end: 'bottom 62%', toggleClass: { targets: item, className: 'is-current' } });
      });
    }, timeline);
    cleanups.push(() => mm.revert());
  });
  document.addEventListener('astro:before-swap', () => cleanups.forEach((cleanup) => cleanup()), { once: true });
</script>
