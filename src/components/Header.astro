---
interface Props { active?: 'home' | 'album'; }
const { active = 'album' } = Astro.props;
---

<header class="site-header sticky top-0 z-30 border-b border-[var(--line)] bg-[rgb(240_239_235_/_0.94)] backdrop-blur-md">
  <div class="container flex min-h-16 items-center justify-between gap-4">
    <a
      class="group inline-flex items-center gap-2.5 text-[var(--charcoal)] no-underline"
      href={active === 'home' ? '/' : '/album'}
      aria-label="Peregrinación Roma y Asís, inicio"
    >
      <img src="/brand/pilgrimage-mark-512.png" width="42" height="42" alt="" class="size-10 object-contain transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105 motion-reduce:transition-none" />
      <span class="font-serif text-[1rem] leading-tight font-semibold tracking-[-0.01em]">
        <small class="mb-0.5 block font-sans text-[0.58rem] font-bold tracking-[0.17em] text-[var(--gold)] uppercase">Álbum del camino</small>
        Roma · Asís
      </span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Navegación principal">
      <a
        href="/album"
        aria-current={active === 'album' ? 'page' : undefined}
        class="hidden min-h-11 items-center px-3 text-[0.8rem] font-bold text-[var(--muted)] no-underline transition-colors hover:text-[var(--charcoal)] sm:inline-flex aria-[current=page]:text-[var(--gold)]"
      >
        Los cinco días
      </a>
      {active === 'album' && (
        <form method="post" action="/api/logout" class="m-0">
          <button type="submit" class="min-h-11 border-0 bg-transparent px-3 text-[0.8rem] font-bold text-[var(--muted)] transition-colors hover:text-[var(--charcoal)]">Salir</button>
        </form>
      )}
    </nav>
  </div>
</header>
