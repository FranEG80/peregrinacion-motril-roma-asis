---
interface Props { active?: 'home' | 'album'; }
const { active = 'album' } = Astro.props;
---

<header class="site-header sticky top-0 z-30 border-b border-[#382e29]/15 bg-[#f3eee4]/95 backdrop-blur-md">
  <div class="mx-auto flex min-h-16 w-[min(1120px,calc(100%-2rem))] items-center justify-between gap-4">
    <a
      class="group inline-flex items-center gap-3 text-[#241f1b] no-underline"
      href={active === 'home' ? '/' : '/album'}
      aria-label="Peregrinación Roma y Asís, inicio"
    >
      <span class="grid size-9 place-items-center border border-[#a2302b] text-lg text-[#a2302b] transition-transform duration-300 group-hover:rotate-45 motion-reduce:transition-none" aria-hidden="true">✦</span>
      <span class="font-serif text-[1.05rem] leading-tight font-semibold tracking-[-0.01em]">
        <small class="mb-0.5 block font-sans text-[0.62rem] font-bold tracking-[0.16em] text-[#8e2925] uppercase">Álbum del camino</small>
        Roma · Asís
      </span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Navegación principal">
      <a
        href="/album"
        aria-current={active === 'album' ? 'page' : undefined}
        class="hidden min-h-11 items-center px-3 text-sm font-bold text-[#514942] no-underline transition-colors hover:text-[#8e2925] sm:inline-flex aria-[current=page]:text-[#8e2925]"
      >
        Los cinco días
      </a>
      {active === 'album' && (
        <form method="post" action="/api/logout" class="m-0">
          <button type="submit" class="min-h-11 border-0 bg-transparent px-3 text-sm font-bold text-[#514942] transition-colors hover:text-[#8e2925]">Salir</button>
        </form>
      )}
    </nav>
  </div>
</header>
