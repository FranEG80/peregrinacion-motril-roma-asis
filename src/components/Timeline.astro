---
interface TimelineItem {
  id: string;
  sequence: number;
  eyebrow: string;
  title: string;
  summary: string;
  date?: string;
  approximateTime?: string;
  image?: string;
  href: string;
  meta?: string;
}

interface Props {
  items: TimelineItem[];
  variant: 'days' | 'places';
  activeId?: string;
  ariaLabel: string;
}

const { items, variant, activeId, ariaLabel } = Astro.props;
---

<div class="timeline" data-timeline data-variant={variant}>
  <div class="timeline__rail" aria-hidden="true"><span class="timeline-progress"></span></div>
  <ol aria-label={ariaLabel}>
    {items.map((item) => (
      <li class:list={['timeline-item', item.id === activeId && 'is-current']} data-timeline-item>
        <span class="timeline-marker" aria-hidden="true">{String(item.sequence).padStart(2, '0')}</span>
        <a href={item.href} aria-current={item.id === activeId ? 'step' : undefined} class="journey-entry">
          {item.image ? (
            <figure class="journey-entry__image" data-view-transition={variant === 'days' ? 'page-cover' : undefined} style={variant === 'days' ? `--view-transition-name: day-cover-${item.id}` : undefined}>
              <img src={item.image} width="960" height="720" alt="" loading="lazy" decoding="async" />
              <figcaption>Capítulo {String(item.sequence).padStart(2, '0')}</figcaption>
            </figure>
          ) : <div class="journey-entry__empty">Recuerdo sin fotografía</div>}
          <div class="journey-entry__copy">
            <p class="journey-entry__meta"><span>{item.date || item.approximateTime || item.eyebrow}</span>{item.meta && <span>{item.meta}</span>}</p>
            <h3 data-view-transition={variant === 'days' ? 'page-title' : undefined} style={variant === 'days' ? `--view-transition-name: day-title-${item.id}` : undefined}>{item.title}</h3>
            <p>{item.summary}</p>
            <span class="journey-entry__link">{variant === 'days' ? `Abrir jornada ${item.sequence}` : 'Abrir parada'} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .timeline { position: relative; margin-top: 2rem; }
  .timeline__rail { position: absolute; top: 0; bottom: 0; left: 1.15rem; width: 1px; background: var(--line); }
  .timeline-progress { display: block; width: 100%; height: 100%; background: var(--gold); transform: scaleY(0); transform-origin: top; }
  ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .timeline-item { position: relative; padding: 0 0 3rem 3.5rem; }
  .timeline-marker { position: absolute; top: 0; left: 0; z-index: 1; display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: var(--paper); color: var(--muted); font-family: var(--font-display); font-size: .72rem; font-variant-numeric: tabular-nums; transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease; }
  .timeline-item.is-current .timeline-marker { border-color: var(--gold); background: var(--gold); color: var(--cream); }
  .journey-entry { display: grid; gap: 1.5rem; border-top: 1px solid var(--line); padding-top: 1.2rem; color: inherit; text-decoration: none; }
  .journey-entry__image { position: relative; min-height: 13rem; margin: 0; overflow: hidden; background: var(--line); }
  .journey-entry__image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85); transition: transform 400ms ease, filter 400ms ease; }
  .journey-entry:hover .journey-entry__image img { filter: saturate(1); transform: scale(1.02); }
  .journey-entry__image figcaption { position: absolute; right: 0; bottom: 0; padding: .35rem .55rem; background: rgb(250 249 246 / .92); color: var(--muted); font-size: .58rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .journey-entry__empty { display: grid; min-height: 11rem; place-items: center; border: 1px dashed var(--line); color: var(--muted); font-size: .68rem; text-transform: uppercase; }
  .journey-entry__copy { align-self: center; max-width: 37rem; }
  .journey-entry__meta { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin: 0 0 .65rem; color: var(--gold); font-size: .62rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .journey-entry__meta span + span { color: var(--muted); }
  .journey-entry h3 { max-width: 20ch; font-size: clamp(1.65rem, 3vw, 2.1rem); }
  .journey-entry__copy > p:not(.journey-entry__meta) { margin: .8rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.65; }
  .journey-entry__link { display: inline-flex; gap: .55rem; margin-top: 1rem; border-bottom: 1px solid var(--gold); color: var(--charcoal); font-size: .72rem; font-weight: 850; }
  .journey-entry__link span { transition: transform 180ms ease; }
  .journey-entry:hover .journey-entry__link span { transform: translateX(.2rem); }

  @media (min-width: 760px) {
    .timeline__rail { left: 1.45rem; }
    .timeline-item { padding-left: 5.2rem; padding-bottom: 4rem; }
    .timeline-marker { width: 2.9rem; height: 2.9rem; font-size: .82rem; }
    .journey-entry { grid-template-columns: minmax(15rem, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4.5rem); }
    .timeline-item:nth-child(even) .journey-entry { grid-template-columns: minmax(0, 1.2fr) minmax(15rem, .8fr); }
    .timeline-item:nth-child(even) .journey-entry__image { order: 2; }
    .timeline-item:nth-child(even) .journey-entry__copy { order: 1; }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const cleanups: Array<() => void> = [];
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((timeline) => {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const progress = timeline.querySelector<HTMLElement>('.timeline-progress');
      if (progress) gsap.to(progress, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: timeline, start: 'clamp(top 68%)', end: 'clamp(bottom 68%)', scrub: .35 } });
      gsap.utils.toArray<HTMLElement>('[data-timeline-item]', timeline).forEach((item) => {
        ScrollTrigger.create({ trigger: item, start: 'top 62%', end: 'bottom 62%', toggleClass: { targets: item, className: 'is-current' } });
      });
    }, timeline);
    cleanups.push(() => mm.revert());
  });
  document.addEventListener('astro:before-swap', () => cleanups.forEach((cleanup) => cleanup()), { once: true });
</script>
