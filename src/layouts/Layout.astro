---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  transitionReadyId?: string;
}

const {
  title = 'Peregrinación a Roma',
  description = 'Álbum privado de una peregrinación de cinco días por Roma.',
  noindex = true,
  transitionReadyId,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="theme-color" content="#f7f2e8" />
    <link rel="icon" href="/favicon.ico" />
    {transitionReadyId && <link rel="expect" href={`#${transitionReadyId}`} blocking="render" />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
  </body>
</html>
