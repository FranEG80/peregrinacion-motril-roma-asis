# Vercel / Astro
# Contraseña única compartida por los invitados.
# Déjala vacía para servir el álbum públicamente.
APP_PASSWORD=
# Mínimo 32 caracteres aleatorios. Obligatorio cuando APP_PASSWORD tiene valor.
SESSION_SECRET=

# Dominio público personalizado de R2, sin barra final.
CLOUDFLARE_R2_ENDPOINT=https://cdn.example.com

# El mismo secreto configurado en el Worker con Wrangler.
MEDIA_TICKET_SECRET=
# URL pública del Worker, sin barra final.
MEDIA_WORKER_URL=
