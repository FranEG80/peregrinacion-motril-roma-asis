# Vercel / Astro
# Contraseña única compartida por los invitados.
APP_PASSWORD=replace-with-a-long-shared-password
# Mínimo 32 caracteres aleatorios. Firma la cookie de sesión.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Contrato Vercel -> Cloudflare Worker
# Debe tener exactamente el mismo valor en Vercel y como secreto del Worker.
MEDIA_TICKET_SECRET=replace-with-another-32-character-random-secret
# URL pública del Worker de medios, sin barra final.
MEDIA_WORKER_URL=https://media.example.com
# URL usada para construir imágenes y vídeos en el navegador.
PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Cloudflare (solo para scripts de importación/despliegue; no exponer al navegador)
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
CLOUDFLARE_R2_BUCKET=peregrinacion-roma

