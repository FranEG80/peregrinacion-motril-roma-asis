# Vercel / Astro
# Contraseña única compartida por los invitados.
APP_PASSWORD=replace-with-a-long-shared-password
# Mínimo 32 caracteres aleatorios. Firma la cookie de sesión.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Dominio público personalizado de R2, sin barra final.
CLOUDFLARE_R2_ENDPOINT=https://cdn.example.com
